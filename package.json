{
  "name": "manyama-scanner",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @manyama/server\" \"npm run dev --workspace @manyama/web\"",
    "build": "npm run build --workspace @manyama/server && npm run build --workspace @manyama/web",
    "test": "npm run test --workspace @manyama/server",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace @manyama/server && npm run typecheck --workspace @manyama/web"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
